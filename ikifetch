# ── 3D & GIF Animation Modes ───────────────────────────────

QUADRANTS = [
    " ", "▗", "▖", "▄",
    "▝", "▐", "▞", "▟",
    "▘", "▚", "▌", "▙",
    "▀", "▜", "▛", "█"
]


class GifRenderer:
    """High-performance terminal GIF animator supporting Kitty Graphics Protocol,
    Truecolor quadrants, half-blocks, or ASCII."""

    def __init__(
        self,
        path: Path | str,
        width: int = CANVAS_WIDTH,
        height: int = CANVAS_HEIGHT,
        style: str = "blocks",
        static: bool = False,
    ):
        if not HAS_PIL:
            raise RuntimeError(
                "Pillow (PIL) is required to render GIFs. Install it with: pacman -S python-pillow"
            )

        self.path = Path(path).expanduser()
        if not self.path.is_file():
            raise FileNotFoundError(f"GIF file not found: {self.path}")

        self.width = width
        self.height = height
        self.style = style.lower()
        self.static = static
        self.frames: list[list[str]] = []
        self.delays: list[float] = []
        self.start_time: float | None = None
        self._load()

    def _load(self):
        with Image.open(self.path) as im:
            last_frame = None

            for frame in ImageSequence.Iterator(im):
                dur = frame.info.get("duration", 100) / 1000.0
                if dur <= 0.01:
                    dur = 0.08
                self.delays.append(dur)

                rgba = frame.convert("RGBA")
                if last_frame is None:
                    last_frame = rgba.copy()
                else:
                    last_frame.alpha_composite(rgba)

                work_img = last_frame.copy()
                img_w, img_h = work_img.width, work_img.height
                if img_w <= 0 or img_h <= 0:
                    continue
                img_aspect = img_w / float(img_h)

                if self.style == "kitty":
                    # High-DPI native GPU pixel rendering for Kitty terminal
                    # In Kitty character cells: cell height is roughly 2x cell width.
                    # Fit inside (width, height) cells with proper aspect ratio:
                    max_w_cells = self.width   # 28
                    max_h_cells = self.height  # 15
                    target_ratio_cells = 2.0 * img_aspect

                    if target_ratio_cells >= max_w_cells / float(max_h_cells):
                        cols = max_w_cells
                        rows = int(round(cols / target_ratio_cells))
                    else:
                        rows = max_h_cells
                        cols = int(round(rows * target_ratio_cells))

                    cols = max(1, min(max_w_cells, cols))
                    rows = max(1, min(max_h_cells, rows))

                    # High resolution backing canvas (16px per col, 32px per row)
                    canvas_w_px = self.width * 16   # 448 px
                    canvas_h_px = self.height * 32  # 480 px

                    # Scale work_img into (cols * 16, rows * 32)
                    box_w = cols * 16
                    box_h = rows * 32
                    scale = min(box_w / float(img_w), box_h / float(img_h))
                    w_px = max(1, int(round(img_w * scale)))
                    h_px = max(1, int(round(img_h * scale)))

                    resized = work_img.resize((w_px, h_px), Image.Resampling.LANCZOS)
                    canvas = Image.new("RGBA", (canvas_w_px, canvas_h_px), (0, 0, 0, 0))
                    ox = (canvas_w_px - w_px) // 2
                    oy = (canvas_h_px - h_px) // 2
                    canvas.paste(resized, (ox, oy))

                    img_id = 0 if self.static else 1
                    self.frames.append(self._render_kitty(canvas, image_id=img_id))

                elif self.style == "quad":
                    # Subpixel quadrants: 2 dots wide x 2 dots high per character cell
                    # Dot physical aspect ratio is ~1:2 (width 0.5, height 1.0).
                    # Physical ratio = (w_dots / h_dots) * 0.5 = img_aspect => w_dots / h_dots = 2.0 * img_aspect
                    max_w = self.width * 2    # 56 dots
                    max_h = self.height * 2   # 30 dots
                    target_ratio = 2.0 * img_aspect

                    if target_ratio >= max_w / float(max_h):
                        w = max_w
                        h = int(round(w / target_ratio))
                    else:
                        h = max_h
                        w = int(round(h * target_ratio))

                    w = max(2, min(max_w, w))
                    h = max(2, min(max_h, h))
                    w = w if w % 2 == 0 else w - 1
                    h = h if h % 2 == 0 else h - 1

                    work_img_sharp = work_img.filter(ImageFilter.UnsharpMask(radius=1.5, percent=150, threshold=2))
                    resized = work_img_sharp.resize((w, h), Image.Resampling.LANCZOS)
                    canvas = Image.new("RGBA", (max_w, max_h), (0, 0, 0, 0))
                    ox = ((max_w - w) // 2) & ~1
                    oy = ((max_h - h) // 2) & ~1
                    canvas.paste(resized, (ox, oy))
                    self.frames.append(self._render_quad(canvas))

                elif self.style == "ascii":
                    max_w = self.width
                    max_h = self.height
                    target_ratio = 2.0 * img_aspect

                    if target_ratio >= max_w / float(max_h):
                        w = max_w
                        h = int(round(w / target_ratio))
                    else:
                        h = max_h
                        w = int(round(h * target_ratio))

                    w = max(1, min(max_w, w))
                    h = max(1, min(max_h, h))

                    resized = work_img.resize((w, h), Image.Resampling.LANCZOS)
                    canvas = Image.new("RGBA", (max_w, max_h), (0, 0, 0, 0))
                    ox = (max_w - w) // 2
                    oy = (max_h - h) // 2
                    canvas.paste(resized, (ox, oy))
                    self.frames.append(self._render_ascii(canvas))

                else:  # "blocks" (Truecolor half-blocks)
                    # 1 dot wide x 2 dots high per character cell.
                    # Each half-block dot is ~1:1 square.
                    # Therefore, dots ratio w_dots / h_dots matches original image aspect ratio img_aspect!
                    max_w = self.width       # 28 dots
                    max_h = self.height * 2  # 30 dots

                    if img_aspect >= max_w / float(max_h):
                        w = max_w
                        h = int(round(w / img_aspect))
                    else:
                        h = max_h
                        w = int(round(h * img_aspect))

                    w = max(1, min(max_w, w))
                    h = max(2, min(max_h, h))
                    h = h if h % 2 == 0 else h - 1

                    work_img_sharp = work_img.filter(ImageFilter.UnsharpMask(radius=1.8, percent=160, threshold=2))
                    resized = work_img_sharp.resize((w, h), Image.Resampling.LANCZOS)
                    canvas = Image.new("RGBA", (max_w, max_h), (0, 0, 0, 0))
                    ox = (max_w - w) // 2
                    oy = ((max_h - h) // 2) & ~1
                    canvas.paste(resized, (ox, oy))
                    self.frames.append(self._render_blocks(canvas))

                if self.static:
                    break

        self.total_duration = sum(self.delays) if self.delays else 1.0

    def _render_kitty(self, canvas, image_id: int = 1) -> list[str]:
        global _kitty_used
        _kitty_used = True
        buf = io.BytesIO()
        canvas.save(buf, format="PNG", compress_level=1)
        b64 = base64.b64encode(buf.getvalue()).decode("ascii")
        chunks = [b64[i : i + 4096] for i in range(0, len(b64), 4096)]
        seq = []
        id_part = f",i={image_id}" if image_id else ""
        for i, c in enumerate(chunks):
            m = 1 if i < len(chunks) - 1 else 0
            if i == 0:
                # a=T: transmit and display
                # f=100: PNG format
                # C=1: Do NOT move cursor (keeps cursor aligned with card layout)
                # c, r: placement width and height in terminal cells
                # q=2: quiet mode (suppress terminal responses)
                seq.append(f"\033_Ga=T,f=100{id_part},C=1,c={self.width},r={self.height},q=2,m={m};{c}\033\\")
            else:
                seq.append(f"\033_Gm={m};{c}\033\\")
        kitty_packet = "".join(seq)
        lines = [" " * self.width] * self.height
        lines[0] = kitty_packet + lines[0]
        return lines

    def _render_quad(self, canvas) -> list[str]:
        lines = []
        for y in range(self.height):
            row = []
            cur_fg, cur_bg = None, None
            for x in range(self.width):
                tl = canvas.getpixel((x * 2, y * 2))
                tr = canvas.getpixel((x * 2 + 1, y * 2))
                bl = canvas.getpixel((x * 2, y * 2 + 1))
                br = canvas.getpixel((x * 2 + 1, y * 2 + 1))
                pts = [tl, tr, bl, br]

                opaques = [p for p in pts if p[3] >= 32]
                if not opaques:
                    if cur_fg is not None or cur_bg is not None:
                        row.append(COLOR_RESET)
                        cur_fg, cur_bg = None, None
                    row.append(" ")
                    continue

                # If some pixels are transparent, keep background default (\033[49m)
                if len(opaques) < 4:
                    avg_fg = (
                        sum(p[0] for p in opaques) // len(opaques),
                        sum(p[1] for p in opaques) // len(opaques),
                        sum(p[2] for p in opaques) // len(opaques),
                    )
                    mask = 0
                    if tl[3] >= 32: mask |= 8
                    if tr[3] >= 32: mask |= 4
                    if bl[3] >= 32: mask |= 2
                    if br[3] >= 32: mask |= 1
                    ch = QUADRANTS[mask]
                    code = ""
                    if cur_bg is not None:
                        code += "\033[49m"
                        cur_bg = None
                    if cur_fg != avg_fg:
                        code += f"\033[38;2;{avg_fg[0]};{avg_fg[1]};{avg_fg[2]}m"
                        cur_fg = avg_fg
                    row.append(code + ch)
                    continue

                lums = [int(0.299 * p[0] + 0.587 * p[1] + 0.114 * p[2]) for p in pts]
                mid_lum = sum(lums) / 4.0

                fg_pts = [p for p, l in zip(pts, lums) if l >= mid_lum]
                bg_pts = [p for p, l in zip(pts, lums) if l < mid_lum]
                if not fg_pts:
                    fg_pts = pts
                if not bg_pts:
                    bg_pts = fg_pts

                avg_fg = (sum(p[0] for p in fg_pts) // len(fg_pts), sum(p[1] for p in fg_pts) // len(fg_pts), sum(p[2] for p in fg_pts) // len(fg_pts))
                avg_bg = (sum(p[0] for p in bg_pts) // len(bg_pts), sum(p[1] for p in bg_pts) // len(bg_pts), sum(p[2] for p in bg_pts) // len(bg_pts))

                mask = 0
                if lums[0] >= mid_lum: mask |= 8
                if lums[1] >= mid_lum: mask |= 4
                if lums[2] >= mid_lum: mask |= 2
                if lums[3] >= mid_lum: mask |= 1

                ch = QUADRANTS[mask]
                code = ""
                if cur_fg != avg_fg:
                    code += f"\033[38;2;{avg_fg[0]};{avg_fg[1]};{avg_fg[2]}m"
                    cur_fg = avg_fg
                if cur_bg != avg_bg and ch != "█":
                    code += f"\033[48;2;{avg_bg[0]};{avg_bg[1]};{avg_bg[2]}m"
                    cur_bg = avg_bg
                row.append(code + ch)

            if cur_fg is not None or cur_bg is not None:
                row.append(COLOR_RESET)
            lines.append("".join(row))
        return lines

    def _render_blocks(self, canvas) -> list[str]:
        lines = []
        for y in range(self.height):
            row = []
            cur_fg = None
            cur_bg = None
            for x in range(self.width):
                top = canvas.getpixel((x, y * 2))
                bot = canvas.getpixel((x, y * 2 + 1))
                t_a, b_a = top[3], bot[3]

                if t_a < 32 and b_a < 32:
                    if cur_fg is not None or cur_bg is not None:
                        row.append(COLOR_RESET)
                        cur_fg = None
                        cur_bg = None
                    row.append(" ")
                elif t_a >= 32 and b_a < 32:
                    fg = (top[0], top[1], top[2])
                    code = ""
                    if cur_bg is not None:
                        code += "\033[49m"
                        cur_bg = None
                    if cur_fg != fg:
                        code += f"\033[38;2;{fg[0]};{fg[1]};{fg[2]}m"
                        cur_fg = fg
                    row.append(code + "▀")
                elif t_a < 32 and b_a >= 32:
                    fg = (bot[0], bot[1], bot[2])
                    code = ""
                    if cur_bg is not None:
                        code += "\033[49m"
                        cur_bg = None
                    if cur_fg != fg:
                        code += f"\033[38;2;{fg[0]};{fg[1]};{fg[2]}m"
                        cur_fg = fg
                    row.append(code + "▄")
                else:
                    fg = (top[0], top[1], top[2])
                    bg = (bot[0], bot[1], bot[2])
                    code = ""
                    if cur_fg != fg:
                        code += f"\033[38;2;{fg[0]};{fg[1]};{fg[2]}m"
                        cur_fg = fg
                    if cur_bg != bg:
                        code += f"\033[48;2;{bg[0]};{bg[1]};{bg[2]}m"
                        cur_bg = bg
                    row.append(code + "▀")
            if cur_fg is not None or cur_bg is not None:
                row.append(COLOR_RESET)
            lines.append("".join(row))
        return lines

    def _render_ascii(self, canvas) -> list[str]:
        ascii_chars = " .·:+=*#%@"
        lines = []
        for y in range(self.height):
            row = []
            cur_fg = None
            for x in range(self.width):
                px = canvas.getpixel((x, y))
                if px[3] < 32:
                    if cur_fg is not None:
                        row.append(COLOR_RESET)
                        cur_fg = None
                    row.append(" ")
                else:
                    lum = int(0.299 * px[0] + 0.587 * px[1] + 0.114 * px[2])
                    ch = ascii_chars[int(lum / 256 * len(ascii_chars))]
                    fg = (px[0], px[1], px[2])
                    code = ""
                    if cur_fg != fg:
                        code += f"\033[38;2;{fg[0]};{fg[1]};{fg[2]}m"
                        cur_fg = fg
                    row.append(code + ch)
            if cur_fg is not None:
                row.append(COLOR_RESET)
            lines.append("".join(row))
        return lines

    def __call__(self, angle: float = 0.0) -> list[str]:
        if not self.frames:
            return [" " * self.width] * self.height
        if self.start_time is None:
            self.start_time = time.time()
        elapsed = (time.time() - self.start_time) % self.total_duration
        t = 0.0
        for idx, d in enumerate(self.delays):
            t += d
            if elapsed < t:
                return self.frames[idx]
        return self.frames[-1]


def resolve_gif_path(target: str | Path | None) -> Path | None:
    """Resolve GIF file from path, name, or common user folders (~/.config/ikifetch/gifs, ~/Pictures, ~/Downloads)."""
    if not target:
        return None
    p = Path(target).expanduser()
    if p.is_file():
        return p
    p_gif = Path(str(target) + ".gif").expanduser()
    if p_gif.is_file():
        return p_gif

    xdg_config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    # Search ~/.config/ikifetch/gifs/
    cfg_gifs = xdg_config / "ikifetch" / "gifs"
    for candidate in [cfg_gifs / target, cfg_gifs / f"{target}.gif"]:
        if candidate.is_file():
            return candidate

    # Search common image folders (~/Pictures/, ~/Downloads/, ~/Пикчи/, ~/Загрузки/)
    for folder in [
        Path.home() / "Pictures",
        Path.home() / "Downloads",
        Path.home() / "Пикчи",
        Path.home() / "Загрузки",
    ]:
        if folder.is_dir():
            for candidate in [folder / target, folder / f"{target}.gif"]:
                if candidate.is_file():
                    return candidate
    return None


# ── Custom Animation Discovery System ──────────────────────

def discover_custom_modes(gif_style: str = "blocks", static: bool = False) -> dict:
    """Discover user-created animation modes and GIFs from ~/.config/ikifetch/."""
    custom = {}
    xdg_config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    config_dir = xdg_config / "ikifetch"
    if not config_dir.is_dir():
        return custom

    # 1. Python script plugins in modes/*.py
    modes_dir = config_dir / "modes"
    if modes_dir.is_dir():
        for py_file in modes_dir.glob("*.py"):
            try:
                mod_name = py_file.stem
                if mod_name in custom:
                    continue
                spec = importlib.util.spec_from_file_location(f"ikifetch_plugin_{mod_name}", str(py_file))
                if spec and spec.loader:
                    mod = importlib.util.module_from_spec(spec)
                    spec.loader.exec_module(mod)
                    if hasattr(mod, "render"):
                        custom[mod_name] = getattr(mod, "render")
            except Exception:
                pass

    # 2. Text frame animations in frames/*.txt
    frames_dir = config_dir / "frames"
    if frames_dir.is_dir():
        for txt_file in frames_dir.glob("*.txt"):
            try:
                anim_name = txt_file.stem
                if anim_name in custom:
                    continue
                content = txt_file.read_text(encoding="utf-8")
                raw_frames = [f.strip("\r\n").split("\n") for f in content.split("---") if f.strip()]
                if raw_frames:
                    def make_frame_renderer(frames_list):
                        def frame_renderer(angle: float):
                            f_idx = int(angle * 4.0) % len(frames_list)
                            f_lines = frames_list[f_idx]
                            out = []
                            for i in range(CANVAS_HEIGHT):
                                if i < len(f_lines):
                                    line = f_lines[i]
                                    out.append(line[:CANVAS_WIDTH].ljust(CANVAS_WIDTH))
                                else:
                                    out.append(" " * CANVAS_WIDTH)
                            return out
                        return frame_renderer
                    custom[anim_name] = make_frame_renderer(raw_frames)
            except Exception:
                pass

    # 3. User GIF animations in gifs/*.gif
    gifs_dir = config_dir / "gifs"
    if gifs_dir.is_dir() and HAS_PIL:
        for gif_file in gifs_dir.glob("*.gif"):
            try:
                anim_name = gif_file.stem
                if anim_name in custom:
                    continue
                def make_gif_renderer(gpath, gstyle, gstatic):
                    _cached = None
                    def _renderer(angle: float = 0.0):
                        nonlocal _cached
                        if _cached is None:
                            _cached = GifRenderer(gpath, width=CANVAS_WIDTH, height=CANVAS_HEIGHT, style=gstyle, static=gstatic)
                        return _renderer
                    return _renderer
                renderer_fn = make_gif_renderer(gif_file, gif_style, static)
                custom[anim_name] = renderer_fn
                custom[gif_file.name] = renderer_fn
            except Exception:
                pass

    return custom


# ── Card Composition & Terminal Centering ───────────────────

def compose_centered_card(art_lines: list[str], info_lines: list[str]) -> str:
    """Compose the card centered dynamically in the terminal window."""
    try:
        cols, rows = shutil.get_terminal_size((80, 24))
    except Exception:
        cols, rows = 80, 24

    art_height = len(art_lines)
    card_height = max(art_height, len(info_lines)) if info_lines else art_height
    top_pad = max((rows - card_height) // 2, 0)

    lines = [""] * top_pad
    if info_lines:
        max_info_w = max((get_visible_width(l) for l in info_lines), default=0)
        total_width = CANVAS_WIDTH + 4 + max_info_w
        left_pad = " " * max((cols - total_width) // 2, 0)
        info_col = len(left_pad) + CANVAS_WIDTH + 4

        for i in range(card_height):
            art = art_lines[i] if i < art_height else " " * CANVAS_WIDTH
            raw_info = info_lines[i] if i < len(info_lines) else ""
            adj_info = adjust_cha(raw_info, info_col)
            lines.append(f"{left_pad}{art}    {adj_info}")
    else:
        left_pad = " " * max((cols - CANVAS_WIDTH) // 2, 0)
        for art in art_lines:
            lines.append(f"{left_pad}{art}")

    return "\n".join(lines)


def run_animated(info_lines: list[str], render_fn, fps: int = 35):
    """Run continuous 3D rotation with bulletproof resize and reflow protection."""
    global _cursor_hidden, _orig_termios, _clear_kitty_on_exit
    _clear_kitty_on_exit = False

    # Safety Guard: If input is already waiting in stdin (e.g. pasted commands or automated input),
    # immediately exit so we never consume or corrupt the user's input stream!
    if has_pending_stdin():
        return

    # Guard against non-interactive environments
    if not is_real_interactive_terminal():
        return

    frame_delay = 1.0 / max(fps, 1)

    try:
        _orig_termios = termios.tcgetattr(sys.stdin.fileno())
        tty.setcbreak(sys.stdin.fileno())
        # Hide cursor (\033[?25l) and disable line wrapping (\033[?7l) to prevent resize reflow tears
        sys.stdout.write("\033[?25l\033[?7l")
        _cursor_hidden = True
    except Exception:
        # If termios configuration fails, safely return without hanging
        return

    angle = 0.0
    _resized = False

    def _on_resize(signum=None, frame=None):
        nonlocal _resized
        _resized = True

    prev_sigwinch = None
    if hasattr(signal, "SIGWINCH"):
        try:
            prev_sigwinch = signal.signal(signal.SIGWINCH, _on_resize)
        except Exception:
            pass

    prev_cols, prev_rows = -1, -1
    last_rendered_bottom = 0

    try:
        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()

        while True:
            # Check for keypress or pasted text without blocking
            try:
                r, _, _ = select.select([sys.stdin], [], [], 0)
                if r:
                    # User pressed a key or pasted input!
                    # Do NOT swallow the key with sys.stdin.read(1)!
                    # Leaving it unread allows the calling shell (fish/bash) to receive it intact.
                    break
            except (InterruptedError, select.error):
                # Interrupted by resize signal (SIGWINCH), flag resize and keep going smoothly
                _resized = True
            except Exception:
                break

            try:
                cols, rows = shutil.get_terminal_size((80, 24))
            except Exception:
                cols, rows = 80, 24

            # Detect resize either via SIGWINCH or terminal dimension poll
            if _resized or cols != prev_cols or rows != prev_rows:
                _resized = False
                prev_cols, prev_rows = cols, rows
                # Clear entire screen and reset Kitty GPU image placement if any
                sys.stdout.write("\033_Ga=d,d=i,i=1\033\\\033[2J\033[H")
                sys.stdout.flush()

            art_lines = render_fn(angle)
            art_height = len(art_lines)
            card_height = max(art_height, len(info_lines)) if info_lines else art_height
            top_pad = max((rows - card_height) // 2, 0)
            start_row = top_pad + 1  # 1-indexed row in terminal

            frame_buf = []
            if info_lines:
                max_info_w = max((get_visible_width(l) for l in info_lines), default=0)
                total_width = CANVAS_WIDTH + 4 + max_info_w
                left_pad = " " * max((cols - total_width) // 2, 0)
                info_col = len(left_pad) + CANVAS_WIDTH + 4

                for i in range(card_height):
                    target_row = start_row + i
                    if target_row > rows:
                        break  # Never write past the bottom row of terminal!
                    art = art_lines[i] if i < art_height else " " * CANVAS_WIDTH
                    raw_info = info_lines[i] if i < len(info_lines) else ""
                    adj_info = adjust_cha(raw_info, info_col)
                    frame_buf.append(f"\033[{target_row};1H\033[2K{left_pad}{art}    {adj_info}")
            else:
                left_pad = " " * max((cols - CANVAS_WIDTH) // 2, 0)
                for i in range(art_height):
                    target_row = start_row + i
                    if target_row > rows:
                        break
                    art = art_lines[i]
                    frame_buf.append(f"\033[{target_row};1H\033[2K{left_pad}{art}")

            last_rendered_bottom = min(start_row + card_height - 1, rows)

            sys.stdout.write("".join(frame_buf))
            sys.stdout.flush()

            angle += 0.045
            time.sleep(frame_delay)
    finally:
        if prev_sigwinch is not None:
            try:
                signal.signal(signal.SIGWINCH, prev_sigwinch)
            except Exception:
                pass

        try:
            cols, rows = shutil.get_terminal_size((80, 24))
            next_row = min(last_rendered_bottom + 1, rows)
            # Position cursor neatly on the line below the card
            sys.stdout.write(f"\033[{next_row};1H\n")
        except Exception:
            sys.stdout.write("\n\n")

        _restore_terminal()
        sys.stdout.flush()


def main():
    parser = argparse.ArgumentParser(
        description="ikifetch — Minimalist animated 3D ASCII and GIF system information fetch."
    )
    parser.add_argument(
        "target",
        nargs="?",
        default=None,
        help="Optional positional target: mode preset name, or path/name of a .gif file.",
    )
    parser.add_argument(
        "style_pos",
        nargs="?",
        choices=["blocks", "quad", "kitty", "ascii", None],
        default=None,
        help="Optional positional style: 'blocks', 'quad', 'kitty', or 'ascii'.",
    )
    parser.add_argument(
        "-m",
        "--mode",
        type=str,
        default=None,
        help="Animation preset, custom mode name, or path to a .gif file (default: globe).",
    )
    parser.add_argument(
        "-g",
        "--gif",
        type=str,
        default=None,
        help="Path or name of a GIF file to play instead of 3D ASCII.",
    )
    parser.add_argument(
        "--gif-style",
        choices=["blocks", "quad", "kitty", "ascii"],
        default="blocks",
        help="Render style for GIF: 'blocks' (Truecolor half-blocks, universal default), 'quad' (subpixel quadrants), 'kitty' (native HD GPU pixel graphics), or 'ascii'.",
    )
    parser.add_argument(
        "--kitty",
        action="store_true",
        help="Use native HD Kitty Graphics Protocol for pixel-perfect GIF rendering in Kitty.",
    )
    parser.add_argument(
        "-r",
        "--random",
        action="store_true",
        help="Pick a random animation mode on launch.",
    )
    parser.add_argument(
        "-s",
        "--static",
        action="store_true",
        help="Print single centered frame statically without animation.",
    )
    parser.add_argument(
        "--fps",
        type=int,
        default=35,
        help="Frame rate for animation (default: 35).",
    )
    parser.add_argument(
        "--list-modes",
        action="store_true",
        help="List all available animation presets (built-in, custom, and GIFs) and exit.",
    )
    parser.add_argument(
        "--check-terminal",
        action="store_true",
        help="Inspect whether current environment is a genuine interactive terminal and exit.",
    )
    parser.add_argument(
        "--force-terminal",
        action="store_true",
        help="Force animation even if terminal safety checks detect a non-interactive shell.",
    )
    parser.add_argument(
        "-c",
        "--config",
        type=str,
        default=None,
        help="Path to custom fastfetch/ikifetch config.jsonc to display system information.",
    )
    parser.add_argument(
        "-ff",
        "--fastfetch",
        action="store_true",
        help="Use default ~/.config/fastfetch/config.jsonc if present.",
    )
    parser.add_argument(
        "--no-info",
        "--art-only",
        dest="no_info",
        action="store_true",
        help="Display only the 3D art or GIF animation without any system info modules.",
    )
    args = parser.parse_args()

    # Determine gif style
    if args.style_pos:
        args.gif_style = args.style_pos

    if args.kitty:
        args.gif_style = "kitty"

    # Diagnostic flag
    if args.check_terminal:
        diag = get_terminal_diagnostics()
        print("ikifetch Terminal Diagnostics:")
        print(f"  • Real Interactive TTY : {'YES' if diag['real_interactive_tty'] else 'NO'}")
        print(f"  • stdin isatty         : {diag['stdin_isatty']}")
        print(f"  • stdout isatty        : {diag['stdout_isatty']}")
        print(f"  • TERM                 : {diag['term']!r}")
        print(f"  • Terminal Dimensions  : {diag['dimensions']}")
        print(f"  • Pending Input        : {diag['pending_stdin']}")
        print(f"  • Pillow (PIL) for GIF : {'AVAILABLE' if diag['has_pil'] else 'NOT INSTALLED'}")
        sys.exit(0 if diag["real_interactive_tty"] else 1)

    custom_modes = discover_custom_modes(gif_style=args.gif_style, static=args.static)
    all_modes = {**BUILTIN_MODES, **custom_modes}

    if args.list_modes:
        print("Built-in 3D animation modes in ikifetch:")
        print("  • globe   / planet  - 3D Raymarched Planet with continental terrain")
        print("  • saturn            - 3D Planet with Tilted Orbital Rings")
        print("  • donut   / torus   - Classic Dual-Axis 3D Mathematical Torus")
        print("  • cube              - True 3D Wireframe and Shaded Rotating Cube")
        print("  • galaxy  / vortex  - Spiral Galaxy with Accretion Core")
        print("  • dna               - Rotating 3D Double Helix Strand")
        print("  • cat     / neko    - Animated Pixel Cat with blinking eyes & swishing tail")
        print("  • heart             - Pulsing 3D Mathematical Heart")
        if custom_modes:
            print("\nUser custom modes & GIFs (~/.config/ikifetch/):")
            for cm in sorted(custom_modes.keys()):
                print(f"  • {cm}")
        return

    cfg_file = get_config_file(args)
    cfg_data = parse_config_json(cfg_file) if cfg_file else {}

    # Resolve target from positional or flags
    chosen_mode = "globe"
    gif_file = None

    if args.gif:
        gif_file = resolve_gif_path(args.gif)
        if not gif_file:
            print(f"ikifetch: GIF file not found: {args.gif}", file=sys.stderr)
            sys.exit(1)
    else:
        target_cand = args.target or args.mode
        if target_cand:
            # Handle if style was passed as first positional (e.g. ikifetch kitty)
            if target_cand in ["blocks", "quad", "kitty", "ascii"]:
                args.gif_style = target_cand
                target_cand = args.mode or "globe"

            # Check if target resolves to a GIF file
            resolved_gif = resolve_gif_path(target_cand)
            if resolved_gif:
                gif_file = resolved_gif
            else:
                chosen_mode = target_cand.lower()
        elif args.mode:
            chosen_mode = args.mode.lower()
        elif not args.random:
            # Check if config specifies a default gif or mode
            cfg_gif = cfg_data.get("gif")
            if not cfg_gif and isinstance(cfg_data.get("logo"), dict):
                src = cfg_data["logo"].get("source")
                if src and isinstance(src, str) and src.lower().endswith(".gif"):
                    cfg_gif = src

            if cfg_gif:
                resolved_gif = resolve_gif_path(cfg_gif)
                if resolved_gif:
                    gif_file = resolved_gif
                    if args.gif_style == "blocks":
                        cfg_style = cfg_data.get("gifStyle") or cfg_data.get("style")
                        if not cfg_style and isinstance(cfg_data.get("logo"), dict):
                            ltype = cfg_data["logo"].get("type", "")
                            if "kitty" in ltype:
                                cfg_style = "kitty"
                        if cfg_style in ["blocks", "quad", "kitty", "ascii"]:
                            args.gif_style = cfg_style
            elif cfg_data.get("mode"):
                chosen_mode = str(cfg_data["mode"]).lower()

    if gif_file:
        render_fn = GifRenderer(
            gif_file,
            width=CANVAS_WIDTH,
            height=CANVAS_HEIGHT,
            style=args.gif_style,
            static=args.static,
        )
    else:
        if args.random:
            chosen_mode = random.choice(list(all_modes.keys()))
        render_fn = all_modes.get(chosen_mode, render_globe)

    info_lines = resolve_config_info(args, cfg_file=cfg_file, cfg_data=cfg_data)

    if args.static:
        art = render_fn(1.2)
        print(compose_centered_card(art, info_lines))
        return

    # ── Real Terminal Safety Guard for Animation ─────────────────
    # If ikifetch is launched in a non-interactive shell (automated tool execution,
    # IDE subtasks, scp/git hooks, or background pipes), avoid hanging or breaking stdin:
    if not args.force_terminal and not is_real_interactive_terminal():
        sys.exit(0)

    run_animated(info_lines, render_fn, fps=args.fps)


if __name__ == "__main__":
    main()
