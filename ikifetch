# Terminal cleanup state
_orig_termios = None
_cursor_hidden = False
_kitty_used = False
_clear_kitty_on_exit = False


def _restore_terminal():
    global _cursor_hidden, _orig_termios, _kitty_used, _clear_kitty_on_exit
    try:
        sys.stdout.write("\033[?7h")  # Re-enable terminal line wrap
    except Exception:
        pass
    if _kitty_used and _clear_kitty_on_exit:
        try:
            # Clear Kitty graphics animation image (ID 1) from terminal
            sys.stdout.write("\033_Ga=d,d=i,i=1\033\\")
            sys.stdout.flush()
        except Exception:
            pass
    if _cursor_hidden:
        try:
            sys.stdout.write("\033[?25h")
            sys.stdout.flush()
        except Exception:
            pass
        _cursor_hidden = False
    if _orig_termios and sys.stdin.isatty():
        try:
            # Use TCSANOW so unread keys in buffer are preserved for the shell!
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSANOW, _orig_termios)
        except Exception:
            pass


atexit.register(_restore_terminal)


def _signal_handler(signum, frame):
    _restore_terminal()
    sys.exit(0)


signal.signal(signal.SIGINT, _signal_handler)
signal.signal(signal.SIGTERM, _signal_handler)



# ── Config & Module Layout System (Fastfetch Compatible) ─────

def strip_ansi(s: str) -> str:
    """Strip ANSI escape sequences from a string."""
    return re.sub(r"\033(?:\[[0-9;?]*[a-zA-Z]|_[^\\\033]*\033\\)", "", s)


def get_visible_width(line: str) -> int:
    """Calculate visible character cell width, accounting for cursor column jumps."""
    m = re.search(r"\033\[(\d+)G(.*)", line)
    if m:
        col = int(m.group(1))
        rest = re.sub(r"\033(?:\[[0-9;?]*[a-zA-Z]|_[^\\\033]*\033\\)", "", m.group(2))
        return col + len(rest)
    return len(strip_ansi(line))


def adjust_cha(line: str, offset: int) -> str:
    """Adjust absolute cursor column codes (\033[...G) relative to left margin."""
    return re.sub(r"\033\[(\d+)G", lambda m: f"\033[{offset + int(m.group(1))}G", line)


def get_config_file(args) -> Optional[Path]:
    """Resolve which config file to use if any exists."""
    xdg_config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    if getattr(args, "config", None):
        cand = Path(args.config).expanduser().resolve()
        if cand.is_file():
            return cand
    elif getattr(args, "fastfetch", False):
        for ff_name in ["config.jsonc", "config.json"]:
            cand = xdg_config / "fastfetch" / ff_name
            if cand.is_file():
                return cand
    else:
        for ik_name in ["config.jsonc", "config.json"]:
            cand = xdg_config / "ikifetch" / ik_name
            if cand.is_file():
                return cand
    return None


def parse_config_json(cfg_file: Path) -> dict:
    """Parse JSON or JSONC file safely stripping comments without touching string literals."""
    try:
        text = cfg_file.read_text(encoding="utf-8")
        out = []
        i = 0
        n = len(text)
        in_str = False
        escape = False

        while i < n:
            c = text[i]
            if in_str:
                out.append(c)
                if escape:
                    escape = False
                elif c == "\\":
                    escape = True
                elif c == '"':
                    in_str = False
                i += 1
            else:
                if c == '"':
                    in_str = True
                    out.append(c)
                    i += 1
                elif c == "/" and i + 1 < n and text[i + 1] == "/":
                    i += 2
                    while i < n and text[i] != "\n":
                        i += 1
                elif c == "/" and i + 1 < n and text[i + 1] == "*":
                    i += 2
                    while i + 1 < n and not (text[i] == "*" and text[i + 1] == "/"):
                        i += 1
                    i += 2
                else:
                    out.append(c)
                    i += 1

        cleaned = "".join(out)
        cleaned = re.sub(r",(\s*[}\]])", r"\1", cleaned)
        return json.loads(cleaned)
    except Exception:
        return {}


def resolve_config_info(args, cfg_file: Optional[Path] = None, cfg_data: Optional[dict] = None) -> list[str]:
    """Retrieve system information lines based on user config.

    Out of the box, ikifetch is clean and displays ONLY the animated art / GIF.
    Users can configure modules by placing a fastfetch-compatible config in:
      • ~/.config/ikifetch/config.jsonc (or config.json)
      • Passing -c / --config <path>
      • Passing -ff / --fastfetch to use ~/.config/fastfetch/config.jsonc
    """
    if getattr(args, "no_info", False):
        return []

    if not cfg_file:
        cfg_file = get_config_file(args)
    if not cfg_file:
        return []

    # Execute fastfetch with user config and no logo if fastfetch is installed
    target_cfg = cfg_file
    tmp_link = None
    if cfg_file.suffix not in [".json", ".jsonc"]:
        try:
            tmp_link = Path(tempfile.gettempdir()) / f"ikifetch_cfg_{os.getpid()}.jsonc"
            if tmp_link.exists() or tmp_link.is_symlink():
                tmp_link.unlink()
            tmp_link.symlink_to(cfg_file)
            target_cfg = tmp_link
        except Exception:
            pass

    try:
        proc = subprocess.run(
            [
                "fastfetch",
                "-c",
                str(target_cfg),
                "-l",
                "none",
                "--pipe",
                "false",
            ],
            capture_output=True,
            text=True,
            timeout=1.5,
            check=False,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            return proc.stdout.splitlines()
    except Exception:
        pass
    finally:
        if tmp_link and (tmp_link.exists() or tmp_link.is_symlink()):
            try:
                tmp_link.unlink()
            except Exception:
                pass

    # Native fallback if fastfetch binary is not installed
    if cfg_data is None:
        cfg_data = parse_config_json(cfg_file)
    return _render_native_modules(cfg_data.get("modules", []))


def _render_native_modules(modules: list) -> list[str]:
    """Lightweight fallback renderer for fastfetch modules without fastfetch binary."""
    user = os.environ.get("USER", "user")
    host = platform.node() or "host"
    lines = []

    for mod in modules:
        if isinstance(mod, str):
            mtype = mod.lower()
            mopt = {}
        elif isinstance(mod, dict):
            mtype = mod.get("type", "").lower()
            mopt = mod
        else:
            continue

        if mtype == "break":
            lines.append("")
        elif mtype == "title":
            lines.append(f"\033[1;38;2;194;198;214m{user}@{host}\033[0m")
        elif mtype == "separator":
            lines.append(mopt.get("string", "─") * 18)
        elif mtype == "os":
            os_name = "Linux"
            try:
                with open("/etc/os-release") as f:
                    for l in f:
                        if l.startswith("PRETTY_NAME="):
                            os_name = l.split("=", 1)[1].strip('"\n')
                            break
            except Exception:
                pass
            lines.append(f"\033[38;2;133;154;234m{mopt.get('key', 'OS'):<10}\033[0m {os_name}")
        elif mtype == "kernel":
            lines.append(f"\033[38;2;133;154;234m{mopt.get('key', 'Kernel'):<10}\033[0m {platform.system()} {platform.release()}")
        elif mtype == "wm":
            wm = os.environ.get("XDG_CURRENT_DESKTOP") or os.environ.get("DESKTOP_SESSION") or "Wayland"
            lines.append(f"\033[38;2;133;154;234m{mopt.get('key', 'WM'):<10}\033[0m {wm}")
        elif mtype == "shell":
            sh = Path(os.environ.get("SHELL", "sh")).name
            lines.append(f"\033[38;2;133;154;234m{mopt.get('key', 'Shell'):<10}\033[0m {sh}")
        elif mtype == "memory":
            mem_str = "Memory"
            try:
                with open("/proc/meminfo") as f:
                    mem_data = {l.split(":")[0].strip(): int(l.split(":")[1].split()[0]) for l in f if ":" in l}
                    tot = mem_data.get("MemTotal", 0) / (1024 * 1024)
                    avail = mem_data.get("MemAvailable", 0) / (1024 * 1024)
                    used = max(tot - avail, 0)
                    pct = int(used / tot * 100) if tot else 0
                    mem_str = f"{used:.2f} GiB / {tot:.2f} GiB ({pct}%)"
            except Exception:
                pass
            lines.append(f"\033[38;2;133;154;234m{mopt.get('key', 'Memory'):<10}\033[0m {mem_str}")
        elif mtype == "cpu":
            cpu_name = platform.processor() or "CPU"
            try:
                with open("/proc/cpuinfo") as f:
                    for l in f:
                        if "model name" in l:
                            cpu_name = l.split(":", 1)[1].strip()
                            break
            except Exception:
                pass
            lines.append(f"\033[38;2;133;154;234m{mopt.get('key', 'CPU'):<10}\033[0m {cpu_name}")
        elif mtype == "disk":
            disk_str = "Disk"
            try:
                du = shutil.disk_usage("/")
                u_gb = du.used / (1024**3)
                t_gb = du.total / (1024**3)
                pct = int(u_gb / t_gb * 100) if t_gb else 0
                disk_str = f"{u_gb:.2f} GiB / {t_gb:.2f} GiB ({pct}%)"
            except Exception:
                pass
            lines.append(f"\033[38;2;133;154;234m{mopt.get('key', 'Disk'):<10}\033[0m {disk_str}")
        elif mtype == "colors":
            dots = " ".join([f"\033[{c}m●\033[0m" for c in ["31", "32", "33", "34", "35", "36", "37"]])
            lines.append(dots)

    return lines


# ── Built-in 3D Mathematical Renderers ─────────────────────

def render_globe(angle: float) -> list[str]:
    """3D Raymarched Planet with continuous surface rotation and lighting."""
    grid = [[" " for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    colors = [["" for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    ry = 6.2
    rx = ry * 2.05
    tilt = 0.38
    cos_t, sin_t = math.cos(tilt), math.sin(tilt)
    cos_a, sin_a = math.cos(angle), math.sin(angle)
    cx, cy = CANVAS_WIDTH / 2.0 - 0.5, CANVAS_HEIGHT / 2.0 - 0.5

    for py in range(CANVAS_HEIGHT):
        dy = (py - cy) / ry
        for px in range(CANVAS_WIDTH):
            dx = (px - cx) / rx
            d2 = dx * dx + dy * dy
            if d2 <= 1.0:
                dz = math.sqrt(max(0.0, 1.0 - d2))
                nx, ny, nz = dx, dy, dz

                y1 = dy * cos_t + dz * sin_t
                z1 = -dy * sin_t + dz * cos_t
                x1 = dx

                x_loc = x1 * cos_a - z1 * sin_a
                z_loc = x1 * sin_a + z1 * cos_a
                y_loc = y1

                lat = math.asin(min(max(y_loc, -1.0), 1.0))
                lon = math.atan2(z_loc, x_loc)

                diff = max(nx * LIGHT[0] + ny * LIGHT[1] + nz * LIGHT[2], 0.0)
                spec = math.pow(max(0.0, (nx * LIGHT[0] + ny * LIGHT[1] + (nz + 1.0) * LIGHT[2]) / 1.7), 4)

                c1 = math.sin(2.0 * lon) * math.cos(3.0 * lat)
                c2 = 0.5 * math.sin(4.0 * lon + 1.5) * math.sin(2.0 * lat)
                c3 = 0.25 * math.cos(6.0 * lon - 2.0) * math.cos(5.0 * lat)
                noise = c1 + c2 + c3

                is_land = noise > 0.05
                grid_line = abs(math.cos(lat * 6.0)) > 0.95 or abs(math.cos(lon * 8.0)) > 0.95

                intensity = 0.48 * diff + 0.22 * dz
                if is_land:
                    intensity += 0.30
                else:
                    intensity += 0.08
                if grid_line:
                    intensity += 0.15
                intensity += 0.35 * spec

                lum = min(max(intensity, 0.0), 1.0)
                grid[py][px] = CHARS[int(lum * (len(CHARS) - 1))]

                if lum > 0.82:
                    colors[py][px] = "\033[38;2;245;244;248m"
                elif is_land:
                    colors[py][px] = "\033[38;2;194;198;214m"
                elif grid_line:
                    colors[py][px] = "\033[38;2;133;154;234m"
                else:
                    colors[py][px] = "\033[38;2;85;90;105m"

    lines = []
    for row_c, row_ch in zip(colors, grid):
        lines.append("".join((c + ch) if ch != " " else " " for c, ch in zip(row_c, row_ch)) + COLOR_RESET)
    return lines


def render_saturn(angle: float) -> list[str]:
    """3D Planet with Tilted Elliptical Rings and Cassini Division."""
    grid = [[" " for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    colors = [["" for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    r_p_y = 4.5
    r_p_x = r_p_y * 2.05
    tilt = 0.45
    cos_t, sin_t = math.cos(tilt), math.sin(tilt)
    cx, cy = CANVAS_WIDTH / 2.0 - 0.5, CANVAS_HEIGHT / 2.0 - 0.5

    for py in range(CANVAS_HEIGHT):
        dy = (py - cy)
        for px in range(CANVAS_WIDTH):
            dx = (px - cx)
            dx_p = dx / r_p_x
            dy_p = dy / r_p_y
            d2_p = dx_p * dx_p + dy_p * dy_p
            z_planet = -999.0
            if d2_p <= 1.0:
                z_planet = math.sqrt(1.0 - d2_p) * r_p_y

            z_ring = -999.0
            if abs(sin_t) > 0.001:
                zr = dy * (cos_t / sin_t)
                yr = dy * sin_t + zr * cos_t
                xr = dx / 2.05
                r_ring = math.sqrt(xr * xr + yr * yr)
                if 5.5 <= r_ring <= 10.5 and (r_ring < 7.2 or r_ring > 7.7):
                    z_ring = zr

            if z_planet > -900 and (z_ring < -900 or z_planet >= z_ring):
                nx, ny, nz = dx_p, dy_p, z_planet / r_p_y
                diff = max(nx * LIGHT[0] + ny * LIGHT[1] + nz * LIGHT[2], 0.0)
                band = math.sin(dy_p * 8.0 + math.sin(angle + dx_p * 2.0) * 0.5)
                lum = min(max(0.45 * diff + 0.35 + band * 0.15, 0.0), 1.0)
                grid[py][px] = CHARS[int(lum * (len(CHARS) - 1))]
                colors[py][px] = "\033[38;2;194;198;214m" if lum > 0.5 else "\033[38;2;133;154;234m"
            elif z_ring > -900:
                in_shadow = (z_ring < 0 and d2_p < 1.0)
                if not in_shadow:
                    lum = min(max(0.55 + 0.35 * math.sin(dx * 0.5 + angle), 0.0), 1.0)
                    grid[py][px] = "=:+*#"[int(lum * 4)]
                    colors[py][px] = "\033[38;2;133;154;234m"

    lines = []
    for row_c, row_ch in zip(colors, grid):
        lines.append("".join((c + ch) if ch != " " else " " for c, ch in zip(row_c, row_ch)) + COLOR_RESET)
    return lines


def render_donut(angle: float) -> list[str]:
    """Classic 3D Mathematical Torus rotating in dual axes."""
    grid = [[" " for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    colors = [["" for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    zbuf = [[-999.0 for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    A = angle
    B = angle * 0.6
    cos_a, sin_a = math.cos(A), math.sin(A)
    cos_b, sin_b = math.cos(B), math.sin(B)
    r1, r2 = 4.2, 2.0

    for j in range(0, 628, 7):
        phi = j / 100.0
        cos_p, sin_p = math.cos(phi), math.sin(phi)
        for i in range(0, 628, 3):
            theta = i / 100.0
            cos_t, sin_t = math.cos(theta), math.sin(theta)

            circ_x = r1 + r2 * cos_t
            circ_y = r2 * sin_t

            x = circ_x * (cos_b * cos_p + sin_a * sin_b * sin_p) - circ_y * cos_a * sin_b
            y = circ_x * (sin_b * cos_p - sin_a * cos_b * sin_p) + circ_y * cos_a * cos_b
            z = circ_x * cos_a * sin_p + circ_y * sin_a

            nx = cos_t * (cos_b * cos_p + sin_a * sin_b * sin_p) - sin_t * cos_a * sin_b
            ny = cos_t * (sin_b * cos_p - sin_a * cos_b * sin_p) + sin_t * cos_a * cos_b
            nz = cos_t * cos_a * sin_p + sin_t * sin_a

            px = int(CANVAS_WIDTH / 2.0 + x * 1.9)
            py = int(CANVAS_HEIGHT / 2.0 + y)

            if 0 <= px < CANVAS_WIDTH and 0 <= py < CANVAS_HEIGHT:
                if z > zbuf[py][px]:
                    zbuf[py][px] = z
                    diff = max(0.0, nx * LIGHT[0] + ny * LIGHT[1] + nz * LIGHT[2])
                    lum = min(max(diff * 0.75 + (z + 6.0) / 15.0 * 0.25, 0.0), 1.0)
                    grid[py][px] = CHARS[int(lum * (len(CHARS) - 1))]
                    if lum > 0.75:
                        colors[py][px] = "\033[38;2;245;244;248m"
                    elif lum > 0.4:
                        colors[py][px] = "\033[38;2;194;198;214m"
                    else:
                        colors[py][px] = "\033[38;2;85;90;105m"

    lines = []
    for row_c, row_ch in zip(colors, grid):
        lines.append("".join((c + ch) if ch != " " else " " for c, ch in zip(row_c, row_ch)) + COLOR_RESET)
    return lines


def render_cube(angle: float) -> list[str]:
    """True 3D Wireframe and Shaded Rotating Cube with illuminated edges and vertices."""
    grid = [[" " for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    colors = [["" for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    zbuf = [[-999.0 for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]

    A = angle * 0.85
    B = angle * 0.65
    C = angle * 0.45
    cx, cy = CANVAS_WIDTH / 2.0 - 0.5, CANVAS_HEIGHT / 2.0 - 0.5

    s = 3.6
    verts = [
        [-s, -s, -s], [s, -s, -s], [s, s, -s], [-s, s, -s],
        [-s, -s, s],  [s, -s, s],  [s, s, s],  [-s, s, s]
    ]
    edges = [
        (0, 1), (1, 2), (2, 3), (3, 0),
        (4, 5), (5, 6), (6, 7), (7, 4),
        (0, 4), (1, 5), (2, 6), (3, 7)
    ]
    faces = [
        ([0, 1, 2, 3], (0, 0, -1)),
        ([4, 5, 6, 7], (0, 0, 1)),
        ([0, 1, 5, 4], (0, -1, 0)),
        ([2, 3, 7, 6], (0, 1, 0)),
        ([0, 3, 7, 4], (-1, 0, 0)),
        ([1, 2, 6, 5], (1, 0, 0))
    ]

    rot_v = []
    for x, y, z in verts:
        x1 = x * math.cos(C) - y * math.sin(C)
        y1 = x * math.sin(C) + y * math.cos(C)
        z1 = z
        x2 = x1 * math.cos(A) + z1 * math.sin(A)
        z2 = -x1 * math.sin(A) + z1 * math.cos(A)
        y2 = y1
        y3 = y2 * math.cos(B) - z2 * math.sin(B)
        z3 = y2 * math.sin(B) + z2 * math.cos(B)
        rot_v.append((x2, y3, z3))

    # Render illuminated face shading
    for v_idx, fn in faces:
        fnx = fn[0] * math.cos(C) - fn[1] * math.sin(C)
        fny = fn[0] * math.sin(C) + fn[1] * math.cos(C)
        fnz = fn[2]
        fx = fnx * math.cos(A) + fnz * math.sin(A)
        fz = -fnx * math.sin(A) + fnz * math.cos(A)
        fy = fny * math.cos(B) - fz * math.sin(B)
        fz2 = fny * math.sin(B) + fz * math.cos(B)

        if fz2 > 0.05:
            diff = max(0.0, fx * LIGHT[0] + fy * LIGHT[1] + fz2 * LIGHT[2])
            p0, p1, p2, p3 = rot_v[v_idx[0]], rot_v[v_idx[1]], rot_v[v_idx[2]], rot_v[v_idx[3]]

            for u_i in range(1, 10):
                u = u_i / 10.0
                for v_i in range(1, 10):
                    v = v_i / 10.0
                    px_3d = (1 - u) * (1 - v) * p0[0] + u * (1 - v) * p1[0] + u * v * p2[0] + (1 - u) * v * p3[0]
                    py_3d = (1 - u) * (1 - v) * p0[1] + u * (1 - v) * p1[1] + u * v * p2[1] + (1 - u) * v * p3[1]
                    pz_3d = (1 - u) * (1 - v) * p0[2] + u * (1 - v) * p1[2] + u * v * p2[2] + (1 - u) * v * p3[2]

                    scr_x = int(cx + px_3d * 1.9)
                    scr_y = int(cy + py_3d)
                    if 0 <= scr_x < CANVAS_WIDTH and 0 <= scr_y < CANVAS_HEIGHT:
                        if pz_3d > zbuf[scr_y][scr_x]:
                            zbuf[scr_y][scr_x] = pz_3d
                            ch = " ·:+=*"[int(diff * 4)]
                            grid[scr_y][scr_x] = ch
                            colors[scr_y][scr_x] = "\033[38;2;85;90;105m" if diff < 0.5 else "\033[38;2;146;144;146m"

    # Draw 3D wireframe edges
    for i1, i2 in edges:
        p1, p2 = rot_v[i1], rot_v[i2]
        dist = math.hypot(p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2])
        steps = int(dist * 5.0) + 1
        for s_i in range(steps + 1):
            t = s_i / float(steps)
            x_e = p1[0] + (p2[0] - p1[0]) * t
            y_e = p1[1] + (p2[1] - p1[1]) * t
            z_e = p1[2] + (p2[2] - p1[2]) * t

            scr_x = int(cx + x_e * 1.9)
            scr_y = int(cy + y_e)
            if 0 <= scr_x < CANVAS_WIDTH and 0 <= scr_y < CANVAS_HEIGHT:
                if z_e >= zbuf[scr_y][scr_x] - 0.2:
                    zbuf[scr_y][scr_x] = z_e + 0.1
                    grid[scr_y][scr_x] = "#"
                    colors[scr_y][scr_x] = "\033[38;2;245;244;248m"

    # Draw highlighted vertices
    for vx, vy, vz in rot_v:
        scr_x = int(cx + vx * 1.9)
        scr_y = int(cy + vy)
        if 0 <= scr_x < CANVAS_WIDTH and 0 <= scr_y < CANVAS_HEIGHT:
            grid[scr_y][scr_x] = "●"
            colors[scr_y][scr_x] = "\033[38;2;255;180;171m"

    lines = []
    for row_c, row_ch in zip(colors, grid):
        lines.append("".join((c + ch) if ch != " " else " " for c, ch in zip(row_c, row_ch)) + COLOR_RESET)
    return lines


def render_galaxy(angle: float) -> list[str]:
    """3D Spiral Galaxy / Accretion Vortex with swirling star arms."""
    grid = [[" " for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    colors = [["" for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    cx, cy = CANVAS_WIDTH / 2.0 - 0.5, CANVAS_HEIGHT / 2.0 - 0.5
    tilt = 0.55
    cos_t, sin_t = math.cos(tilt), math.sin(tilt)

    num_particles = 180
    for i in range(num_particles):
        t = (i / float(num_particles)) * 4.5 * math.pi
        r = (i / float(num_particles)) * 9.5 + 0.5

        for arm in [0, math.pi]:
            theta = t + arm - angle * 1.2
            scatter_r = math.sin(i * 12.3) * 0.4
            scatter_th = math.cos(i * 7.7) * 0.2

            x_g = (r + scatter_r) * math.cos(theta + scatter_th)
            y_g = (r + scatter_r) * math.sin(theta + scatter_th)
            z_g = math.sin(i * 5.1) * (0.8 * (1.0 - r / 10.0))

            yt = y_g * cos_t - z_g * sin_t

            px = int(cx + x_g * 1.35)
            py = int(cy + yt)

            if 0 <= px < CANVAS_WIDTH and 0 <= py < CANVAS_HEIGHT:
                intensity = 1.0 - (r / 10.5)
                idx = int(intensity * (len(CHARS) - 1))
                ch = CHARS[min(max(idx, 1), len(CHARS) - 1)]
                grid[py][px] = ch
                if r < 3.0:
                    colors[py][px] = "\033[38;2;245;244;248m"
                elif r < 6.5:
                    colors[py][px] = "\033[38;2;133;154;234m"
                else:
                    colors[py][px] = "\033[38;2;192;198;220m"

    grid[int(cy)][int(cx)] = "●"
    colors[int(cy)][int(cx)] = "\033[38;2;255;180;171m"

    lines = []
    for row_c, row_ch in zip(colors, grid):
        lines.append("".join((c + ch) if ch != " " else " " for c, ch in zip(row_c, row_ch)) + COLOR_RESET)
    return lines


def render_dna(angle: float) -> list[str]:
    """Rotating 3D Double Helix DNA Strand with base-pair rungs."""
    grid = [[" " for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    colors = [["" for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    zbuf = [[-999.0 for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    cx = CANVAS_WIDTH / 2.0 - 0.5
    r = 5.5

    for row in range(CANVAS_HEIGHT):
        t = (row / CANVAS_HEIGHT) * 3.5 * math.pi + angle
        x1 = r * math.cos(t)
        z1 = r * math.sin(t)
        x2 = -x1
        z2 = -z1

        num_rung = 14
        for step in range(num_rung + 1):
            alpha = step / float(num_rung)
            xr = x1 * (1.0 - alpha) + x2 * alpha
            zr = z1 * (1.0 - alpha) + z2 * alpha

            px = int(cx + xr * 1.6)
            py = row
            if 0 <= px < CANVAS_WIDTH and 0 <= py < CANVAS_HEIGHT:
                if zr > zbuf[py][px]:
                    zbuf[py][px] = zr
                    grid[py][px] = "═" if (0 < step < num_rung) else "●"
                    if step in (0, num_rung):
                        colors[py][px] = "\033[38;2;245;244;248m" if zr > 0 else "\033[38;2;133;154;234m"
                    else:
                        colors[py][px] = "\033[38;2;194;198;214m" if zr > 0 else "\033[38;2;85;90;105m"

    lines = []
    for row_c, row_ch in zip(colors, grid):
        lines.append("".join((c + ch) if ch != " " else " " for c, ch in zip(row_c, row_ch)) + COLOR_RESET)
    return lines


def render_cat(angle: float) -> list[str]:
    """Animated Pixel Cat with blinking eyes, twitching ears, and swishing tail."""
    grid = [[" " for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    colors = [["" for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]

    blink = (math.sin(angle * 1.5) > 0.85)
    swish = math.sin(angle * 3.0)

    eye = "^ . ^" if blink else "o . o"
    tail1 = "   ) " if swish > 0.3 else ("  (  " if swish < -0.3 else "  |  ")
    tail2 = "  (  " if swish > 0.3 else ("   ) " if swish < -0.3 else "  |  ")
    tail3 = "   ~ " if swish > 0.3 else (" ~   " if swish < -0.3 else "  ~  ")

    cat_lines = [
        "",
        "        |\\___/|        ",
        f"       / {eye} \\       ",
        "      (  = v =  )      ",
        "       )       (       ",
        f"      /         \\  {tail3.strip()}",
        f"     (           ) {tail2.strip()}",
        f"    ( (  |   |  ) ){tail1.strip()}",
        "     (__d|___|b__)     ",
        "",
        "       \"ฅ(ﾐචᆽචﾐ)ฅ\"       ",
        "",
        "",
        "",
        ""
    ]

    for y, l in enumerate(cat_lines):
        if y < CANVAS_HEIGHT:
            for x, ch in enumerate(l):
                if x < CANVAS_WIDTH:
                    grid[y][x] = ch
                    if ch in "o^":
                        colors[y][x] = "\033[38;2;255;180;171m"  # Eyes
                    elif ch in "v=":
                        colors[y][x] = "\033[38;2;232;207;141m"  # Nose
                    elif ch in "()|/\\_db~":
                        colors[y][x] = "\033[38;2;194;198;214m"  # Body
                    else:
                        colors[y][x] = "\033[38;2;133;154;234m"  # Paws

    lines = []
    for row_c, row_ch in zip(colors, grid):
        lines.append("".join((c + ch) if ch != " " else " " for c, ch in zip(row_c, row_ch)) + COLOR_RESET)
    return lines


def render_heart(angle: float) -> list[str]:
    """Pulsing 3D Mathematical Wireframe Heart."""
    grid = [[" " for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    colors = [["" for _ in range(CANVAS_WIDTH)] for _ in range(CANVAS_HEIGHT)]
    pulse = 1.0 + 0.12 * math.sin(angle * 4.0)
    cx, cy = CANVAS_WIDTH / 2.0 - 0.5, CANVAS_HEIGHT / 2.0 - 0.5

    for py in range(CANVAS_HEIGHT):
        y = -(py - cy) / (4.8 * pulse)
        for px in range(CANVAS_WIDTH):
            x = (px - cx) / (9.6 * pulse)
            # 2D/3D heart implicit curve: (x^2 + y^2 - 1)^3 - x^2 * y^3 <= 0
            val = (x * x + y * y - 1.0) ** 3 - (x * x) * (y * y * y)
            if val <= 0.05:
                edge = abs(val) < 0.15
                grid[py][px] = "#" if edge else ("*" if abs(val) < 0.35 else "·")
                if edge:
                    colors[py][px] = "\033[38;2;255;180;171m"  # Bright heart coral
                else:
                    colors[py][px] = "\033[38;2;192;198;220m" if (px + py) % 2 == 0 else "\033[38;2;146;144;146m"

    lines = []
    for row_c, row_ch in zip(colors, grid):
        lines.append("".join((c + ch) if ch != " " else " " for c, ch in zip(row_c, row_ch)) + COLOR_RESET)
    return lines


