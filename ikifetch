# ── Terminal Detection & Safety Helpers ───────────────────────

def is_real_interactive_terminal() -> bool:
    """Detect whether ikifetch is running inside a genuine interactive user terminal.

    Returns False if running in a non-interactive subshell, script, pipe, CI,
    background runner, or dumb terminal, preventing hangs, swallowed keystrokes,
    and corrupted terminal output.
    """
    # 1. Both stdin and stdout must be real TTYs
    try:
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            return False
    except Exception:
        return False

    # 2. Check TERM environment variable
    term = os.environ.get("TERM", "").strip().lower()
    if not term or term in ("dumb", "unknown", "emacs"):
        return False

    # 3. Check for headless, CI, or automated script environments
    if os.environ.get("DEBIAN_FRONTEND") == "noninteractive":
        return False
    if os.environ.get("CI") in ("true", "1", "yes"):
        return False

    # 4. Check terminal dimensions
    try:
        cols, rows = shutil.get_terminal_size((0, 0))
        if cols < 30 or rows < 8:
            return False
    except Exception:
        return False

    # 5. Verify termios can interact with stdin fileno
    try:
        termios.tcgetattr(sys.stdin.fileno())
    except Exception:
        return False

    return True


def has_pending_stdin() -> bool:
    """Check if input is already buffered in stdin (e.g. pasted commands)."""
    try:
        if not sys.stdin.isatty():
            return False
        r, _, _ = select.select([sys.stdin], [], [], 0)
        return bool(r)
    except Exception:
        return False


def get_terminal_diagnostics() -> dict:
    """Gather diagnostic info about terminal environment."""
    cols, rows = shutil.get_terminal_size((0, 0))
    return {
        "real_interactive_tty": is_real_interactive_terminal(),
        "stdin_isatty": getattr(sys.stdin, "isatty", lambda: False)(),
        "stdout_isatty": getattr(sys.stdout, "isatty", lambda: False)(),
        "term": os.environ.get("TERM"),
        "dimensions": f"{cols}x{rows}",
        "pending_stdin": has_pending_stdin(),
        "has_pil": HAS_PIL,
    }


