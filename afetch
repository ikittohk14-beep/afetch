def compose_centered_card(art_lines: list[str], info_lines: list[str]) -> str:
    """Compose the card centered dynamically in the terminal window."""
    try:
        cols, rows = shutil.get_terminal_size((80, 24))
    except Exception:
        cols, rows = 80, 24

    top_pad = max((rows - CARD_RAW_HEIGHT) // 2, 0)
    left_pad = " " * max((cols - CARD_RAW_WIDTH) // 2, 0)

    lines = [""] * top_pad
    for art, info in zip(art_lines, info_lines):
        lines.append(f"{left_pad}{art}    {info}\033[K")
    return "\n".join(lines)


def run_animated(info: dict, render_fn, fps: int = 35):
    """Run continuous 3D rotation until any key is pressed or Ctrl+C."""
    global _cursor_hidden, _orig_termios

    # Safety Guard: If input is already waiting in stdin (e.g. pasted commands or automated input),
    # immediately exit so we never consume or corrupt the user's input stream!
    if has_pending_stdin():
        return

    # Guard against non-interactive environments
    if not is_real_interactive_terminal():
        return

    info_lines = build_info_lines(info)
    frame_delay = 1.0 / max(fps, 1)

    try:
        _orig_termios = termios.tcgetattr(sys.stdin.fileno())
        tty.setcbreak(sys.stdin.fileno())
        sys.stdout.write("\033[?25l")
        _cursor_hidden = True
    except Exception:
        # If termios configuration fails, safely return without hanging
        return

    angle = 0.0

    try:
        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()

        while True:
            # Check for keypress or pasted text without blocking
            try:
                r, _, _ = select.select([sys.stdin], [], [], 0)
                if r:
                    # User pressed a key or pasted input!
                    # Do NOT swallow the key with sys.stdin.read(1)!
                    # Leaving it unread allows the calling shell (fish/bash) to receive it intact.
                    break
            except Exception:
                break

            art_lines = render_fn(angle)
            card = compose_centered_card(art_lines, info_lines)

            sys.stdout.write("\033[H" + card)
            sys.stdout.flush()

            angle += 0.045
            time.sleep(frame_delay)
    finally:
        _restore_terminal()
        sys.stdout.write("\n\n")
        sys.stdout.flush()


def main():
    parser = argparse.ArgumentParser(
        description="afetch — Minimalist animated 3D ASCII and GIF system information fetch."
    )
    parser.add_argument(
        "-m",
        "--mode",
        type=str,
        default="globe",
        help="Animation preset, custom mode name, or path to a .gif file (default: globe).",
    )
    parser.add_argument(
        "-g",
        "--gif",
        type=str,
        default=None,
        help="Path or name of a GIF file to play instead of 3D ASCII.",
    )
    parser.add_argument(
        "--gif-style",
        choices=["blocks", "quad", "kitty", "ascii"],
        default="quad",
        help="Render style for GIF: 'quad' (subpixel quadrants, default), 'kitty' (native HD pixel graphics), 'blocks' (half-blocks), or 'ascii'.",
    )
    parser.add_argument(
        "--kitty",
        action="store_true",
        help="Use native HD Kitty Graphics Protocol for pixel-perfect GIF rendering in Kitty.",
    )
    parser.add_argument(
        "-r",
        "--random",
        action="store_true",
        help="Pick a random animation mode on launch.",
    )
    parser.add_argument(
        "-s",
        "--static",
        action="store_true",
        help="Print single centered frame statically without animation.",
    )
    parser.add_argument(
        "--fps",
        type=int,
        default=35,
        help="Frame rate for animation (default: 35).",
    )
    parser.add_argument(
        "--list-modes",
        action="store_true",
        help="List all available animation presets (built-in, custom, and GIFs) and exit.",
    )
    parser.add_argument(
        "--check-terminal",
        action="store_true",
        help="Inspect whether current environment is a genuine interactive terminal and exit.",
    )
    parser.add_argument(
        "--force-terminal",
        action="store_true",
        help="Force animation even if terminal safety checks detect a non-interactive shell.",
    )
    args = parser.parse_args()

    if args.kitty:
        args.gif_style = "kitty"

    # Diagnostic flag
    if args.check_terminal:
        diag = get_terminal_diagnostics()
        print("afetch Terminal Diagnostics:")
        print(f"  • Real Interactive TTY : {'YES' if diag['real_interactive_tty'] else 'NO'}")
        print(f"  • stdin isatty         : {diag['stdin_isatty']}")
        print(f"  • stdout isatty        : {diag['stdout_isatty']}")
        print(f"  • TERM                 : {diag['term']!r}")
        print(f"  • Terminal Dimensions  : {diag['dimensions']}")
        print(f"  • Pending Input        : {diag['pending_stdin']}")
        print(f"  • Pillow (PIL) for GIF : {'AVAILABLE' if diag['has_pil'] else 'NOT INSTALLED'}")
        sys.exit(0 if diag["real_interactive_tty"] else 1)

    custom_modes = discover_custom_modes(gif_style=args.gif_style)
    all_modes = {**BUILTIN_MODES, **custom_modes}

    if args.list_modes:
        print("Built-in 3D animation modes in afetch:")
        print("  • globe   / planet  - 3D Raymarched Planet with continental terrain")
        print("  • saturn            - 3D Planet with Tilted Orbital Rings")
        print("  • donut   / torus   - Classic Dual-Axis 3D Mathematical Torus")
        print("  • cube              - True 3D Wireframe and Shaded Rotating Cube")
        print("  • galaxy  / vortex  - Spiral Galaxy with Accretion Core")
        print("  • dna               - Rotating 3D Double Helix Strand")
        print("  • cat     / neko    - Animated Pixel Cat with blinking eyes & swishing tail")
        print("  • heart             - Pulsing 3D Mathematical Heart")
        if custom_modes:
            print("\nUser custom modes & GIFs (~/.config/afetch/):")
            for cm in sorted(custom_modes.keys()):
                print(f"  • {cm}")
        return

    render_fn = None

    # Option 1: Direct --gif argument
    if args.gif:
        gif_candidate = Path(args.gif).expanduser()
        if not gif_candidate.is_file():
            # Check ~/.config/afetch/gifs/<name>
            cfg_dir = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "afetch" / "gifs"
            if (cfg_dir / f"{args.gif}.gif").is_file():
                gif_candidate = cfg_dir / f"{args.gif}.gif"
            elif (cfg_dir / args.gif).is_file():
                gif_candidate = cfg_dir / args.gif
            else:
                print(f"afetch: GIF file not found: {args.gif}", file=sys.stderr)
                sys.exit(1)
        render_fn = GifRenderer(gif_candidate, width=CANVAS_WIDTH, height=CANVAS_HEIGHT, style=args.gif_style)

    # Option 2: -m pointing directly to a .gif file
    elif args.mode and (args.mode.lower().endswith(".gif") or Path(args.mode).expanduser().is_file()):
        file_candidate = Path(args.mode).expanduser()
        if file_candidate.is_file() and (file_candidate.suffix.lower() == ".gif" or file_candidate.name.endswith(".gif")):
            render_fn = GifRenderer(file_candidate, width=CANVAS_WIDTH, height=CANVAS_HEIGHT, style=args.gif_style)

    if render_fn is None:
        mode_name = args.mode.lower()
        if args.random:
            mode_name = random.choice(list(all_modes.keys()))
        render_fn = all_modes.get(mode_name, render_globe)

    info = fetch_system_info()

    if args.static:
        art = render_fn(1.2)
        info_lines = build_info_lines(info)
        print(compose_centered_card(art, info_lines))
        return

    # ── Real Terminal Safety Guard for Animation ─────────────────
    # If afetch is launched in a non-interactive shell (automated tool execution,
    # IDE subtasks, scp/git hooks, or background pipes), avoid hanging or breaking stdin:
    if not args.force_terminal and not is_real_interactive_terminal():
        sys.exit(0)

    run_animated(info, render_fn, fps=args.fps)


if __name__ == "__main__":
    main()
