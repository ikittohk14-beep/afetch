def build_info_lines(data: dict) -> list[str]:
    """Format the right-side information card matching the minimalist layout."""
    uh = data["user_host"]
    header_pad = " " * 12
    return [
        f"{header_pad}{COLOR_BOLD}{COLOR_TEXT}{uh}{COLOR_RESET}",
        "",
        f"{COLOR_DIM}{'OS':<9}{COLOR_DIVIDER}│ {COLOR_TEXT}{data['os']}{COLOR_RESET}",
        f"{COLOR_DIM}{'Host':<9}{COLOR_DIVIDER}│ {COLOR_TEXT}{data['host']}{COLOR_RESET}",
        f"{COLOR_DIM}{'Kernel':<9}{COLOR_DIVIDER}│ {COLOR_TEXT}{data['kernel']}{COLOR_RESET}",
        f"{COLOR_DIM}{'WM':<9}{COLOR_DIVIDER}│ {COLOR_TEXT}{data['wm']}{COLOR_RESET}",
        "",
        f"{COLOR_DIM}{'CPU':<9}{COLOR_DIVIDER}│ {COLOR_TEXT}{data['cpu']}{COLOR_RESET}",
        f"{COLOR_DIM}{'GPU':<9}{COLOR_DIVIDER}│ {COLOR_TEXT}{data['gpu']}{COLOR_RESET}",
        f"{COLOR_DIM}{'Memory':<9}{COLOR_DIVIDER}│ {COLOR_TEXT}{data['memory']}{COLOR_RESET}",
        f"{COLOR_DIM}{'Disk':<9}{COLOR_DIVIDER}│ {COLOR_TEXT}{data['disk']}{COLOR_RESET}",
        "",
        f"{COLOR_DIM}{'Packages':<9}{COLOR_DIVIDER}│ {COLOR_TEXT}{data['packages']}{COLOR_RESET}",
        f"{COLOR_DIM}{'Terminal':<9}{COLOR_DIVIDER}│ {COLOR_TEXT}{data['terminal']}{COLOR_RESET}",
        f"{COLOR_DIM}{'Colors':<9}{COLOR_DIVIDER}│ {DOTS}",
    ]


def compose_centered_card(art_lines: list[str], info_lines: list[str]) -> str:
    """Compose the card centered dynamically in the terminal window."""
    try:
        cols, rows = shutil.get_terminal_size((80, 24))
    except Exception:
        cols, rows = 80, 24

    top_pad = max((rows - CARD_RAW_HEIGHT) // 2, 0)
    left_pad = " " * max((cols - CARD_RAW_WIDTH) // 2, 0)

    lines = [""] * top_pad
    for art, info in zip(art_lines, info_lines):
        lines.append(f"{left_pad}{art}    {info}\033[K")
    return "\n".join(lines)


def run_animated(info: dict, render_fn, fps: int = 35):
    """Run continuous 3D rotation until any key is pressed or Ctrl+C."""
    global _cursor_hidden, _orig_termios
    info_lines = build_info_lines(info)
    frame_delay = 1.0 / max(fps, 1)

    is_tty = sys.stdin.isatty() and sys.stdout.isatty()
    if is_tty:
        _orig_termios = termios.tcgetattr(sys.stdin.fileno())
        tty.setcbreak(sys.stdin.fileno())
        sys.stdout.write("\033[?25l")
        _cursor_hidden = True

    angle = 0.0

    try:
        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()

        while True:
            if is_tty:
                r, _, _ = select.select([sys.stdin], [], [], 0)
                if r:
                    sys.stdin.read(1)
                    break

            art_lines = render_fn(angle)
            card = compose_centered_card(art_lines, info_lines)

            sys.stdout.write("\033[H" + card)
            sys.stdout.flush()

            angle += 0.045
            time.sleep(frame_delay)
    finally:
        _restore_terminal()
        sys.stdout.write("\n\n")
        sys.stdout.flush()


def main():
    parser = argparse.ArgumentParser(
        description="afetch — Minimalist animated 3D ASCII system information fetch."
    )
    parser.add_argument(
        "-m",
        "--mode",
        type=str,
        default="globe",
        choices=list(ANIMATION_MODES.keys()),
        help="Animation preset to render (default: globe).",
    )
    parser.add_argument(
        "-r",
        "--random",
        action="store_true",
        help="Pick a random 3D animation mode on launch.",
    )
    parser.add_argument(
        "-s",
        "--static",
        action="store_true",
        help="Print single centered frame statically without animation.",
    )
    parser.add_argument(
        "--fps",
        type=int,
        default=35,
        help="Frame rate for animation (default: 35).",
    )
    parser.add_argument(
        "--list-modes",
        action="store_true",
        help="List all available animation presets and exit.",
    )
    args = parser.parse_args()

    if args.list_modes:
        print("Available 3D ASCII animation modes in afetch:")
        print("  • globe   / planet  - 3D Rotating Planet with continental terrain")
        print("  • saturn            - 3D Planet with Tilted Orbital Rings")
        print("  • donut   / torus   - Classic Dual-Axis 3D Mathematical Torus")
        print("  • cube              - Solid/Wireframe Rotating 3D Cube")
        print("  • galaxy  / vortex  - Spiral Galaxy with Accretion Core")
        print("  • dna               - Rotating 3D Double Helix Strand")
        return

    mode_name = args.mode.lower()
    if args.random:
        mode_name = random.choice(["globe", "saturn", "donut", "cube", "galaxy", "dna"])

    render_fn = ANIMATION_MODES.get(mode_name, render_globe)
    info = fetch_system_info()

    if args.static:
        art = render_fn(1.2)
        info_lines = build_info_lines(info)
        print(compose_centered_card(art, info_lines))
        return

    run_animated(info, render_fn, fps=args.fps)


if __name__ == "__main__":
    main()
